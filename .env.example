# =============================================================================
# Claude API Configuration
# =============================================================================
# Получите API ключ на https://console.anthropic.com/

# ОБЯЗАТЕЛЬНАЯ ПЕРЕМЕННАЯ
CLAUDE_API_KEY=sk-ant-api03-ваш_ключ_здесь

# ОПЦИОНАЛЬНЫЕ ПЕРЕМЕННЫЕ (можно не указывать, будут использованы значения по умолчанию)

# Модель Claude для использования
# Доступные модели: claude-haiku-4-5-20251001, claude-sonnet-4-5-20250929, etc.
# CLAUDE_MODEL=claude-haiku-4-5-20251001

# Максимальное количество токенов в ответе
# CLAUDE_MAX_TOKENS=1024

# Температура генерации (0.0 - 1.0)
# Меньше значение = более предсказуемые ответы
# Больше значение = более креативные ответы
# CLAUDE_TEMPERATURE=1.0


# =============================================================================
# OpenAI API Configuration
# =============================================================================
# Получите API ключ на https://platform.openai.com/api-keys
# ВАЖНО: Ключи должны храниться в .env файле и не должны попадать в систему контроля версий!

# ОБЯЗАТЕЛЬНАЯ ПЕРЕМЕННАЯ для использования OpenAI
OPENAI_API_KEY=sk-proj-ваш_ключ_здесь

# ОПЦИОНАЛЬНЫЕ ПЕРЕМЕННЫЕ

# Organization ID (если используется)
# Получите на https://platform.openai.com/settings/organization
# OPENAI_ORGANIZATION_ID=org-ваш_organization_id

# Project ID (если используется)
# Получите на https://platform.openai.com/settings/organization/projects
# OPENAI_PROJECT_ID=proj_ваш_project_id

# Модель OpenAI для использования по умолчанию
# Доступные модели: gpt-4-turbo, gpt-4, gpt-3.5-turbo, gpt-4o, etc.
# OPENAI_MODEL=gpt-4-turbo

# Максимальное количество токенов в ответе
# OPENAI_MAX_TOKENS=4096

# Температура генерации (0.0 - 2.0)
# Меньше значение = более предсказуемые ответы
# Больше значение = более креативные ответы
# OPENAI_TEMPERATURE=1.0


# =============================================================================
# HuggingFace API Configuration
# =============================================================================
# Получите API ключ на https://huggingface.co/settings/tokens
# ВАЖНО: Ключ должен храниться в .env и не должен попадать в систему контроля версий!

# ОБЯЗАТЕЛЬНАЯ ПЕРЕМЕННАЯ для использования HuggingFace
HUGGINGFACE_API_KEY=hf_ваш_ключ_здесь

# ОПЦИОНАЛЬНЫЕ ПЕРЕМЕННЫЕ

# Модель HuggingFace для использования по умолчанию
# Доступные модели: deepseek-ai/DeepSeek-R1:fastest, meta-llama/Llama-3.3-70B-Instruct, etc.
# HUGGINGFACE_MODEL=deepseek-ai/DeepSeek-R1:fastest

# Максимальное количество токенов в ответе
# HUGGINGFACE_MAX_TOKENS=8192

# Температура генерации (0.0 - 2.0)
# Меньше значение = более предсказуемые ответы
# Больше значение = более креативные ответы
# HUGGINGFACE_TEMPERATURE=1.0


# =============================================================================
# Ollama Configuration (Local LLM Server)
# =============================================================================
# Ollama - это локальный сервер для запуска LLM моделей на вашем компьютере
# Скачайте на https://ollama.com/
# ВАЖНО: Ollama НЕ требует API ключа! Все работает локально.

# ВСЕ ПЕРЕМЕННЫЕ ОПЦИОНАЛЬНЫ (есть разумные значения по умолчанию)

# URL вашего Ollama сервера (по умолчанию: http://localhost:11434)
# Может быть localhost или удаленный сервер
# OLLAMA_BASE_URL=http://localhost:11434

# Время хранения модели в памяти после использования (по умолчанию: 5m)
# Форматы: "5m" (5 минут), "1h" (1 час), "30s" (30 секунд)
# OLLAMA_KEEP_ALIVE=5m

# Модель по умолчанию для использования (по умолчанию: llama3.2)
# Доступные модели зависят от того, что установлено на вашем Ollama сервере
# Примеры: llama3.2, mistral, gemma, codellama, llava, etc.
# Установите модели командой: ollama pull <model-name>
# OLLAMA_MODEL=llama3.2

# ПРИМЕЧАНИЕ:
# - Реальные подключения управляются через REST API и веб-интерфейс
# - Можно добавлять несколько подключений к разным Ollama серверам
# - Поддерживается переключение между подключениями без перезапуска
# - Документация API: /api/v2/providers/ollama/connections
